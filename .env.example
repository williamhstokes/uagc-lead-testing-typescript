# -----------------------------------------------------------------------------
# Target page
# -----------------------------------------------------------------------------
BASE_URL=https://www.uagc.edu
LEAD_FORM_PATH=/request-information
TARGET_ENV=live

# Optional: narrow Playwright to one specific form/container.
# Recommended after Drupal data-qa attributes are added.
FORM_CONTAINER_SELECTOR=
FORM_INDEX=0

# Optional for a password-protected Pantheon environment. Supply both or neither.
HTTP_USERNAME=
HTTP_PASSWORD=

# Preferred choices. Leave interest/degree blank to select the first usable item.
TEST_STATE_LABEL=Arizona
TEST_INTEREST_LABEL=
TEST_DEGREE_LABEL=
TEST_RN_ANSWER=no
TEST_MILITARY_ANSWER=no

# Mock-safe identity. example.invalid cannot receive email.
TEST_EMAIL_DOMAIN=example.invalid
TEST_PHONE=4805550100

# Optional hidden fields added by Drupal for correlation and test routing.
TEST_RUN_ID_FIELD_SELECTOR=input[name="test_run_id"]
TEST_MODE_FIELD_SELECTOR=input[name="is_test_lead"]

# -----------------------------------------------------------------------------
# Mocked payload-contract test
# No request is allowed to write to an external service after the guard is armed.
# -----------------------------------------------------------------------------
ENABLE_MOCKED_SUBMISSION=false
ALLOW_LIVE_MOCKED_SUBMISSION=false

# JavaScript regular expression matched against the exact lead endpoint URL.
# Example: ^https://lead-sandbox\.example\.edu/api/v1/leads$
# The unique test email/phone are also used to identify the request.
LEAD_ENDPOINT_URL_PATTERN=

MOCK_SUCCESS_STATUS=200
MOCK_SUCCESS_BODY={"success":true,"status":"received","leadId":"{runId}"}
MOCK_CAPTURE_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Real sandbox integration test
# This project permanently refuses real submissions to uagc.edu.
# -----------------------------------------------------------------------------
ENABLE_SANDBOX_SUBMISSION=false
SANDBOX_SUBMISSION_CONFIRMATION=
# Required value: CREATE_TEST_LEAD_IN_SANDBOX

# Comma-separated exact hosts, suffixes beginning with a dot, or wildcard hosts.
# Use the exact approved host whenever possible. No host is trusted by default.
SAFE_SUBMISSION_HOSTS=

# Replace with an approved internal test mailbox/domain before sandbox submission.
# TEST_EMAIL_DOMAIN=qa-leads.your-approved-domain.edu

# Optional UI success detection.
SUCCESS_SELECTOR=
SUCCESS_TEXT_PATTERN=thank you|request received|information submitted
SUCCESS_TIMEOUT_MS=30000

# Optional downstream verification API.
# Supported placeholders: {runId}, {email}, {emailEncoded}
CRM_VERIFY_URL_TEMPLATE=
CRM_VERIFY_TOKEN=
CRM_VERIFY_AUTH_SCHEME=Bearer
CRM_VERIFY_TIMEOUT_MS=120000
